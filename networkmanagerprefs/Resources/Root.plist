			<key>label</key>					<string>Show 5g NR</string>
			<key>PostNotification</key> 		<string>me.nixuge.networkmanager/prefsupdated</string>
		</dict>

		<dict>
			<key>cell</key> 					<string>PSEditTextCell</string>
			<key>default</key> 					<string></string>
			<key>defaults</key> 				<string>me.nixuge.networkmanager</string>
			<key>placeholder</key> 				<string>Auto Network</string>
			<key>noAutoCorrect</key> 			<true/>
			<key>key</key> 						<string>customText</string>
			<key>label</key> 					<string></string>
			<key>PostNotification</key> 		<string>me.nixuge.networkmanager/prefsupdated</string>
		</dict>

		<!-- Spacing cell to have the "What do I need to enable" button separate -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string></string>
		</dict>

		<dict>
			<key>cell</key> 					<string>PSButtonCell</string>
			<key>label</key> 					<string>What do I need to enable?</string>
			<key>action</key> 					<string>showHelpAlert:</string>
		</dict>

		<dict>
			<key>cell</key> 					<string>PSGroupCell</string>
			<key>label</key> 					<string>Band Diagnostics</string>
			<key>footerText</key> 				<string>Read-only. Queries active and supported bands for each SIM without changing modem settings.</string>
		</dict>

		<dict>
			<key>cell</key> 					<string>PSButtonCell</string>
			<key>label</key> 					<string>Query Active / Supported Bands</string>
			<key>action</key> 					<string>showBandProbe:</string>
		</dict>

		<dict>
			<key>cell</key> 					<string>PSGroupCell</string>
			<key>label</key> 					<string>Write Authorization Experiment</string>
			<key>footerText</key> 				<string>Experimental. Slot 1 only. Saves a full snapshot, writes the identical active-band set, verifies it, then restores and verifies the snapshot. It does not select or remove any band.</string>
		</dict>

		<dict>
			<key>cell</key> 					<string>PSButtonCell</string>
			<key>label</key> 					<string>Test Same-Value Band Write</string>
			<key>action</key> 					<string>confirmSameValueBandWrite:</string>
		</dict>

		<dict>
			<key>cell</key> 					<string>PSGroupCell</string>
			<key>label</key> 					<string>Cold Band Removal Experiment</string>
			<key>footerText</key> 				<string>Experimental. Slot 1 only. Removes exactly one cold LTE band (48 CBRS, else 46 LAA), reads the result back to see whether the modem really applied it, then restores the full original set. All other radio technologies stay byte-identical.</string>
		</dict>

		<dict>
			<key>cell</key> 					<string>PSButtonCell</string>
			<key>label</key> 					<string>Test Cold LTE Band Removal</string>
			<key>action</key> 					<string>confirmColdBandRemovalWrite:</string>
		</dict>

		<dict>
			<key>cell</key> 					<string>PSGroupCell</string>
			<key>label</key> 					<string>NR n78-Only Experiment</string>
			<key>footerText</key> 				<string>Experimental. Slot 1 only. Sets only the NR allowed-band array to [78] for 60 seconds, leaving LTE and every other RAT array byte-identical, then restores and verifies the complete original snapshot.</string>
		</dict>

		<dict>
			<key>cell</key> 					<string>PSButtonCell</string>
			<key>label</key> 					<string>Test NR n78 Only for 60 Seconds</string>
			<key>action</key> 					<string>confirmNR78BandWrite:</string>
		</dict>

		<dict>
			<key>cell</key> 					<string>PSButtonCell</string>
			<key>label</key> 					<string>Restore Saved Band Snapshot</string>
			<key>action</key> 					<string>confirmRestoreBandSnapshot:</string>
		</dict>

		<dict>
			<key>cell</key> 					<string>PSButtonCell</string>
			<key>label</key> 					<string>Clear Saved Probe State</string>
			<key>action</key> 					<string>confirmClearProbeState:</string>
		</dict>

		<dict>
			<key>cell</key> 					<string>PSGroupCell</string>
			<key>label</key> 					<string>Support</string>
			<key>footerText</key> 				<string>Developed with ♥ by NoisyFlake &amp; Nixuge</string>
			<key>footerAlignment</key> 			<string>1</string>
		</dict>
		<dict>
            <key>cell</key> 		            <string>PSLinkCell</string>
            <key>cellClass</key> 	            <string>CCNMTelegramCell</string>
            <key>height</key> 		            <real>60.0</real>
            <key>hasIcon</key> 		            <true/>
        </dict>
