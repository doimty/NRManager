	<key>items</key>
	<array>
		<dict>
			<key>cell</key>						<string>PSGroupCell</string>
			<key>footerCellClass</key>			<string>NetworkManagerLogo</string>
 		</dict>

 		<dict>
			<key>cell</key> 					<string>PSGroupCell</string>
