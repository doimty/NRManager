		</dict>

		<dict>
			<key>cell</key>						<string>PSSwitchCell</string>
			<key>default</key>					<true/>
			<key>defaults</key>					<string>me.nixuge.networkmanager</string>
			<key>key</key>						<string>enableLTE</string>
			<key>label</key>					<string>Show LTE</string>
			<key>PostNotification</key> 		<string>me.nixuge.networkmanager/prefsupdated</string>
		</dict>

		<dict>
			<key>cell</key>						<string>PSSwitchCell</string>
			<key>default</key>					<true/>
			<key>defaults</key>					<string>me.nixuge.networkmanager</string>
			<key>key</key>						<string>enable5gNRStandAlone</string>
			<key>label</key>					<string>Show 5g NR StandAlone</string>
			<key>PostNotification</key> 		<string>me.nixuge.networkmanager/prefsupdated</string>
		</dict>
		<dict>
			<key>cell</key>						<string>PSSwitchCell</string>
			<key>default</key>					<true/>
			<key>defaults</key>					<string>me.nixuge.networkmanager</string>
			<key>key</key>						<string>enable5gNRNonStandAlone</string>
			<key>label</key>					<string>Show 5g NR Non StandAlone</string>
			<key>PostNotification</key> 		<string>me.nixuge.networkmanager/prefsupdated</string>
		</dict>
		<dict>
			<key>cell</key>						<string>PSSwitchCell</string>
			<key>default</key>					<true/>
			<key>defaults</key>					<string>me.nixuge.networkmanager</string>
