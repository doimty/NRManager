#!/bin/sh
# Generated from package-actions/prerm.sh.in by
# scripts/patch-maintenance-launchd.py. Do not edit the installed copy.
#
# The removal gate is fail-closed: a forced NR band configuration must not be
# left behind with no installed way to restore it. A guard that cannot be started
# is therefore not an implicit approval, because an unverified modem state is
# exactly the case the gate exists for. The manual override is named in every
# blocking message so a broken guard can never make the package unremovable.
#
# Shell rather than a compiled maintainer script for the same reason as postinst:
# on roothide a compiled maintainer script observably runs without the bootstrap
# injection and gets EPERM on child exec, which would have turned every removal
# into a permanent block.

SCHEME_PREFIX='@PREFIX@'
NEEDS_JBROOT='@NEEDS_JBROOT@'
# What must literally appear inside the launchd plist, decided at package time.
# Empty on roothide because launchctl prepends the jailbreak root itself; /var/jb
# on rootless because nothing there rewrites anything. See postinst.sh.in for the
# launchctl behaviour this rests on.
LAUNCHD_PREFIX='@LAUNCHD_PREFIX@'

GUARD_RELATIVE='/usr/libexec/networkmanager-removal-guard'
OVERRIDE_RELATIVE='/var/lib/dpkg/info/me.nixuge.networkmanager.prerm'
# Rendered from the same constant the plist carries, so this script and the plist
# cannot disagree about which job to boot out.
LAUNCHD_LABEL='@LAUNCHD_LABEL@'

# jbroot's output is an external input. An implausible but non-empty value must
# not become PREFIX_FALLBACK: a bogus prefix that happens to hold a stale copy of
# the guard would let a wrong binary answer a question this gate is fail-closed
# about. Rejecting it leaves PREFIX_FALLBACK empty, which blocks unless the bare
# path resolves — the correct conservative outcome.
validate_jbroot() {
    case "$1" in
        '')
            printf 'jbroot produced no output'
            return 1
            ;;
        *'
'*)
            printf 'jbroot produced more than one line'
            return 1
            ;;
        /*)
            ;;
        *)
            printf 'jbroot produced a relative path'
            return 1
            ;;
    esac
    if [ ! -d "$1" ]; then
        printf 'jbroot named a path that is not a directory'
        return 1
    fi
    return 0
}

JBROOT_PREFIX=''
JBROOT_STATUS='not applicable to this install scheme'
if [ -n "$NEEDS_JBROOT" ]; then
    _jbroot="$(jbroot 2>/dev/null)"
    while :; do
        case "$_jbroot" in
            */) _jbroot="${_jbroot%/}" ;;
            *) break ;;
        esac
        [ -n "$_jbroot" ] || break
    done
    if _reason="$(validate_jbroot "$_jbroot")"; then
        JBROOT_PREFIX="$_jbroot"
        JBROOT_STATUS="$JBROOT_PREFIX"
    else
        JBROOT_STATUS="could not be resolved; ${_reason}"
    fi
    PREFIX_PRIMARY=''
    PREFIX_FALLBACK="$JBROOT_PREFIX"
else
    PREFIX_PRIMARY="$SCHEME_PREFIX"
    PREFIX_FALLBACK=''
fi

describe_prefix() {
    if [ -z "$1" ]; then
        printf 'the redirected root (bare paths)'
    else
        printf '%s' "$1"
    fi
}

candidate_list() {
    describe_prefix "$PREFIX_PRIMARY"
    if [ -n "$PREFIX_FALLBACK" ]; then
        printf ' and %s' "$PREFIX_FALLBACK"
    fi
}

# Not called in a command substitution: that would run in a subshell and lose
# RESOLVED_PREFIX, so the override path printed on failure would be wrong.
RESOLVED_PATH=''
RESOLVED_PREFIX=''
resolve() {
    _relative="$1"
    RESOLVED_PATH=''
    RESOLVED_PREFIX=''
    if [ -e "${PREFIX_PRIMARY}${_relative}" ]; then
        RESOLVED_PREFIX="$PREFIX_PRIMARY"
    elif [ -n "$PREFIX_FALLBACK" ] && [ -e "${PREFIX_FALLBACK}${_relative}" ]; then
        RESOLVED_PREFIX="$PREFIX_FALLBACK"
    else
        return 1
    fi
    RESOLVED_PATH="${RESOLVED_PREFIX}${_relative}"
    return 0
}

# Where the override actually lives. dpkg's own info directory is inside the
# jailbreak root, so the bare path is only correct for a redirected shell. The
# user reading this message is already blocked, so name the path that exists
# rather than the one that happens to be shortest.
#
# Does its own -e tests instead of calling resolve(): this is used inside a
# command substitution, where resolve()'s global assignments would be lost.
override_hint() {
    if [ -e "${PREFIX_PRIMARY}${OVERRIDE_RELATIVE}" ]; then
        printf '%s' "${PREFIX_PRIMARY}${OVERRIDE_RELATIVE}"
    elif [ -n "$PREFIX_FALLBACK" ] &&
         [ -e "${PREFIX_FALLBACK}${OVERRIDE_RELATIVE}" ]; then
        printf '%s' "${PREFIX_FALLBACK}${OVERRIDE_RELATIVE}"
    elif [ -n "$PREFIX_FALLBACK" ]; then
        printf '%s or %s' \
            "${PREFIX_PRIMARY}${OVERRIDE_RELATIVE}" \
            "${PREFIX_FALLBACK}${OVERRIDE_RELATIVE}"
    else
        printf '%s' "${PREFIX_PRIMARY}${OVERRIDE_RELATIVE}"
    fi
}

warn() {
    printf 'NetworkManagerReborn: warning — %s\n' "$1" >&2
}

@LAUNCHCTL_SUPPORT@
LAUNCHD_TARGET="system/${LAUNCHD_LABEL}"

block() {
    printf 'NetworkManagerReborn: removal blocked; %s\n' "$1" >&2
    printf '  Reinstall the package to restore the guard, or delete %s and retry to override.\n' \
        "$(override_hint)" >&2
    exit 73
}

if ! resolve "$GUARD_RELATIVE"; then
    block "the removal guard was not found under $(candidate_list), so the live band configuration cannot be proven clean. jbroot: ${JBROOT_STATUS}."
fi

guard="$RESOLVED_PATH"

# Hand both prefixes over rather than letting the guard re-derive them: it is
# invoked through a bare path, so its own executable path carries no .jbroot-
# component and there is nothing to derive from.
#
# NETWORKMANAGER_INSTALL_PREFIX is what the guard prepends to open a file, and it
# must be the real jailbreak root -- not the prefix this script resolved for
# itself. Exporting the latter was a real bug with its worst consequence right
# here. This shell is path-redirected, so its `/` already is the jailbreak root and
# RESOLVED_PREFIX is legitimately empty; the guard is not redirected, so the same
# bare path lands on the real root, every policy record reads as absent, and
# "absent" is indistinguishable from "no band configuration was ever applied".
# That is exactly the conclusion this gate exists to refuse to reach by accident:
# it would authorize removal while a forced band configuration is still live, with
# the Settings UI that could restore it going away in the same transaction.
#
# An empty prefix is a statement about this shell, not about the filesystem, and it
# must not cross a process boundary. So it is left unset when the jailbreak root is
# unknown, and the guard fails closed on an unresolved prefix.
#
# NETWORKMANAGER_LAUNCHD_PREFIX is a different question -- what must literally
# appear inside the plist -- and it is legitimately empty on roothide, so it is
# always exported. Empty and unset are distinct answers to the guard.
# Whether the prefix was handed over is stated either way. This is the
# fail-closed direction, so an unset install prefix is about to turn into a
# blocked removal, and the reason has to be in the dpkg log next to the block
# message rather than inferable only from the guard's own wording.
if [ -n "$NEEDS_JBROOT" ]; then
    if [ -n "$JBROOT_PREFIX" ]; then
        NETWORKMANAGER_INSTALL_PREFIX="$JBROOT_PREFIX"
        export NETWORKMANAGER_INSTALL_PREFIX
    else
        warn "the jailbreak root ${JBROOT_STATUS}, so the guard was given no install prefix and will fail closed rather than read the wrong root."
    fi
else
    NETWORKMANAGER_INSTALL_PREFIX="$SCHEME_PREFIX"
    export NETWORKMANAGER_INSTALL_PREFIX
fi
NETWORKMANAGER_LAUNCHD_PREFIX="$LAUNCHD_PREFIX"
export NETWORKMANAGER_LAUNCHD_PREFIX

# stdin is closed so a maintainer-script child cannot sit on dpkg's descriptors.
# stdout and stderr are deliberately left attached: this guard's verdict text is
# the whole point of running it and belongs in the dpkg log.
"$guard" "$@" </dev/null
status=$?

# 126 and 127 are the shell's own "found but not executable" and "not found"
# codes. They are the shapes an exec refusal takes here, and they are not a
# verdict from the guard, so they must not be reported as one.
if [ "$status" -eq 126 ] || [ "$status" -eq 127 ]; then
    block "the removal guard at ${guard} could not be started (exit ${status}), so the live band configuration cannot be proven clean."
fi

# A nonzero verdict stops here with the guard's own code, and the daemon is left
# running. Stopping it would be a side effect on a path that just refused to
# proceed: the package stays installed, the user is told to recover in Settings,
# and automatic serving-state monitoring should still be working while they do.
if [ "$status" -ne 0 ]; then
    exit "$status"
fi

# Removal is going ahead, so stop the daemon before dpkg unlinks its binary. This
# is the last point at which the job can be booted out by a script that is still
# installed.
#
# Deliberately not a blocking condition. dpkg removes the plist along with the
# package, so a job that cannot be booted out now also cannot come back after a
# reboot; the only live risk is a still-running instance, which is why each
# failure is still reported.
#
# Running the guard first is safe in the other direction too: the guard reads the
# durable policy records, while the daemon only writes its own status and record
# files and never touches the modem, so a live daemon cannot change the verdict or
# interfere with the restore the guard may have just performed.
if ! resolve_delay_command; then
    # Nothing can be bounded without a delay command, and an unbounded launchctl
    # call is what hung an install. Removal continues: dpkg unlinks the plist with
    # the package, so a job left running now cannot return after a reboot.
    warn "no usable sleep command was found, so launchctl could not be run under a deadline and a running maintenance owner was left alone. It stops at the next reboot, and the launchd job is removed with the package."
elif resolve_launchctl; then
    if ! launchd_bootout; then
        warn "the maintenance owner could not be stopped and may keep running until the next reboot. Removal continues, and the launchd job is removed with the package, so it will not return."
    fi
else
    warn "launchctl could not be run${LAUNCHCTL_REPORT:+ (tried ${LAUNCHCTL_REPORT})}, so a running maintenance owner was left alone. It stops at the next reboot, and the launchd job is removed with the package."
fi

exit 0
