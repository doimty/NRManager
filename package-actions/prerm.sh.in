#!/bin/sh
# Generated from package-actions/prerm.sh.in by
# scripts/patch-maintenance-launchd.py. Do not edit the installed copy.
#
# Removal cannot undo a narrowed band configuration, and this script's job is to
# not make that worse.
#
# 1.6.0 shipped a removal that ran `killall -9 CommCenter` twice and treated two
# zero exit codes as a restored modem. The target device disproved the premise:
# the bands stay narrowed. Worse, that success claim then authorised deleting the
# policy records -- including the baseline, which holds the only copy of the
# user's pre-enable band configuration. So the one path that could not restore
# was also the one path that destroyed the means of restoring.
#
# Both halves are gone. Nothing here signals CommCenter, and the baseline is
# never deleted while it still describes something to undo. Undoing a narrowed
# modem needs a reverse setActiveBandInfo: write against CoreTelephony, which
# lives in the Settings bundle; a dpkg maintainer script is not a place to
# attempt that. The honest sequence is to disable in Settings first, and if the
# package is already gone, to reinstall it and disable -- which only works
# because the records below survive.
#
# Shell rather than a compiled maintainer script for the same reason as postinst:
# on roothide a compiled maintainer script observably runs without the bootstrap
# injection and gets EPERM on child exec, which would have turned every removal
# into a permanent block.

SCHEME_PREFIX='@PREFIX@'
NEEDS_JBROOT='@NEEDS_JBROOT@'
LAUNCHD_PREFIX='@LAUNCHD_PREFIX@'

LAUNCHD_LABEL='@LAUNCHD_LABEL@'
LAUNCHD_TARGET="system/${LAUNCHD_LABEL}"

# jbroot's output is an external input. An implausible but non-empty value must
# not become PREFIX_FALLBACK: a bogus prefix is where the policy records would be
# looked for, and a wrong root there means this script reports "nothing to undo"
# about a directory that was never the real one. Rejecting it leaves
# PREFIX_FALLBACK empty, so only the bare paths are tried -- which is the correct
# conservative outcome, and the shape the reporting device actually has.
validate_jbroot() {
    case "$1" in
        '')
            printf 'jbroot produced no output'
            return 1
            ;;
        *'
'*)
            printf 'jbroot produced more than one line'
            return 1
            ;;
        /*)
            ;;
        *)
            printf 'jbroot produced a relative path'
            return 1
            ;;
    esac
    if [ ! -d "$1" ]; then
        printf 'jbroot named a path that is not a directory'
        return 1
    fi
    return 0
}

JBROOT_PREFIX=''
JBROOT_STATUS='not applicable to this install scheme'
if [ -n "$NEEDS_JBROOT" ]; then
    _jbroot="$(jbroot 2>/dev/null)"
    while :; do
        case "$_jbroot" in
            */) _jbroot="${_jbroot%/}" ;;
            *) break ;;
        esac
        [ -n "$_jbroot" ] || break
    done
    if _reason="$(validate_jbroot "$_jbroot")"; then
        JBROOT_PREFIX="$_jbroot"
        JBROOT_STATUS="$JBROOT_PREFIX"
    else
        JBROOT_STATUS="could not be resolved; ${_reason}"
    fi
    PREFIX_PRIMARY=''
    PREFIX_FALLBACK="$JBROOT_PREFIX"
else
    PREFIX_PRIMARY="$SCHEME_PREFIX"
    PREFIX_FALLBACK=''
fi

describe_prefix() {
    if [ -z "$1" ]; then
        printf 'the redirected root (bare paths)'
    else
        printf '%s' "$1"
    fi
}

warn() {
    printf 'NetworkManagerReborn: warning — %s\n' "$1" >&2
}

note() {
    printf 'NetworkManagerReborn: %s\n' "$1" >&2
}

# The resolved root is worth one line in the dpkg log either way. Everything this
# script decides -- whether a baseline is still on disk, and which records it may
# discard -- is looked for under it, so a failed resolution changes what happened
# and has to be visible next to the warnings it causes.
if [ -n "$NEEDS_JBROOT" ] && [ -z "$JBROOT_PREFIX" ]; then
    warn "the jailbreak root ${JBROOT_STATUS}, so only bare paths were tried. any policy record inspection and cleanup were limited to what resolves without it."
fi

@LAUNCHCTL_SUPPORT@
@POLICY_RECORD_SUPPORT@

# dpkg calls prerm for four different things, and only one of them always means
# the package is going away:
#
#   remove          the package is being retired
#   upgrade         a successor is about to be unpacked over it
#   failed-upgrade  an upgrade aborted; runs from the incoming package
#   deconfigure     this package stays unpacked, to be reconfigured
#
# Only `remove` is acted on. The other three keep a package installed that reads
# these records and ships the Settings UI that owns them, so there is nothing to
# tidy and nothing to warn about.
#
# There is deliberately no version comparison any more. 1.6.0 compared the
# incoming version against a floor to decide whether the successor could undo a
# narrowed modem, and reset when it could not. Both sides of that were wrong: the
# reset did not undo anything, and no version needs protecting from records it can
# simply ignore. Removing the comparison also removes a dpkg child process, a
# delay-command dependency, and the fail-open branch that once reset on every
# ordinary upgrade because the delay command had not been resolved yet.
ACTION="${1:-}"

# Resolved up front because the launchctl bootout at the end of this script is a
# child process, and launchctl_run refuses to run one unbounded.
#
# Nothing above it needs a child process any more. 1.6.0 also ran a dpkg version
# comparison and two killall invocations through here, and resolving the delay
# command too late made every comparison report "below the floor" and reset the
# modem on every ordinary upgrade. With those gone, a missing delay command costs
# only the bootout.
if ! resolve_delay_command; then
    warn "no usable delay command was found, so no child process could be bounded. a running maintenance owner was left alone. It stops at the next reboot."
fi

# A baseline on disk is the load-bearing fact: it means an enable is still in
# effect, and it holds the only copy of the configuration that predates it.
BASELINE_PRESENT=''
if policy_baseline_present; then
    BASELINE_PRESENT=1
fi

if [ "$ACTION" != remove ]; then
    note "action '${ACTION:-none}' keeps this package installed, so its policy records were left alone."
elif [ -n "$BASELINE_PRESENT" ]; then
    # The one message that matters. It is a warning rather than a note because the
    # user is losing the only tool that can undo this, and it names the way back.
    warn "the NR band configuration is still narrowed and removal CANNOT undo it. Removing this package does not restore the carrier's band configuration; only turning the preference off in Settings does, because that needs a modem write this script cannot perform. The saved original configuration is being kept on disk, so reinstalling and turning the preference off still works."
else
    note "no band configuration was in effect, so there was nothing to undo."
fi

# Records are discarded only when there is provably nothing left to undo, which
# means no baseline. Anything else and they stay: they are the only remaining
# description of what was changed and how to change it back, and a reinstall needs
# them. Deleting them on the strength of a signal that a process was killed is
# what 1.6.0 did, and it destroyed exactly this evidence.
if [ "$ACTION" = remove ] && [ -z "$BASELINE_PRESENT" ] && ! discard_policy_records; then
    warn "some policy records could not be removed, so a later reinstall may report a stale transition."
fi

# The band selection is user preference data, not policy evidence. It is not in
# the policy record set and deliberately outlives the off state, because a
# selection can be edited while the feature is disabled. Removal is the one
# moment it has no owner left, and dpkg will not do it: the file lives under
# /var/mobile/Library/Preferences and was never part of the package payload.
#
# Leaving it behind is worse than untidy. A stored band the current SIM no longer
# offers makes the toggle refuse, and nothing in Settings names the stored value,
# so the one remedy every user reaches for -- remove and reinstall -- would
# silently inherit the same selection and fail the same way.
#
# Only on `remove`, and deliberately not on an upgrade or downgrade: those keep a
# package installed, and the version it lands on either reads this file or ignores
# it, so the selection is still the user's to keep. Independent of the baseline,
# because preference data cannot leave the modem in a worse state.
if [ "$ACTION" = remove ] && ! discard_band_selection; then
    warn "the stored NR band selection could not be discarded, so a later reinstall will inherit it."
fi

# Stop the daemon before dpkg unlinks its binary. Deliberately not a blocking
# condition: dpkg removes the plist along with the package, so a job that
# cannot be booted out now also cannot come back after a reboot.
if [ -z "$LAUNCHCTL_DELAY" ]; then
    :  # already warned once, up front
elif resolve_launchctl; then
    launchd_bootout
    bootout_status=$?
    if [ "$bootout_status" -eq 1 ]; then
        warn "the maintenance owner could not be stopped and may keep running until the next reboot. removal continues, and the launchd job is removed with the package, so it will not return."
    elif [ "$bootout_status" -eq 2 ]; then
        warn "launchd did not answer within ${LAUNCHCTL_DEADLINE_SECONDS}s, so the maintenance owner may keep running until the next reboot. removal continues, and the launchd job is removed with the package, so it will not return."
    fi
else
    warn "launchctl could not be run${LAUNCHCTL_REPORT:+ (tried ${LAUNCHCTL_REPORT})}, so a running maintenance owner was left alone. It stops at the next reboot, and the launchd job is removed with the package."
fi

exit 0