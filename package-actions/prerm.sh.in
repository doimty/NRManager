#!/bin/sh
# Generated from package-actions/prerm.sh.in by
# scripts/patch-maintenance-launchd.py. Do not edit the installed copy.
#
# Removal now reloads carrier defaults before dpkg unlinks any file. The old
# removal guard tracked whether the package still had a band configuration to
# restore before uninstalling; that is gone, because the recovery primitive is
# now a carrier reset (killall -9 CommCenter) that needs no record to know what
# to undo. The reset runs first, and policy records are discarded only if the
# reset succeeds. An unconfirmed reset never blocks removal: the records are
# left in place so a reinstall can finish the job, and the user is warned.
#
# Shell rather than a compiled maintainer script for the same reason as postinst:
# on roothide a compiled maintainer script observably runs without the bootstrap
# injection and gets EPERM on child exec, which would have turned every removal
# into a permanent block.

SCHEME_PREFIX='@PREFIX@'
NEEDS_JBROOT='@NEEDS_JBROOT@'
LAUNCHD_PREFIX='@LAUNCHD_PREFIX@'

LAUNCHD_LABEL='@LAUNCHD_LABEL@'
LAUNCHD_TARGET="system/${LAUNCHD_LABEL}"

# jbroot's output is an external input. An implausible but non-empty value must
# not become PREFIX_FALLBACK: a bogus prefix is where the killall candidates and
# the policy record paths would be looked for, and a wrong root there means the
# reset runs against nothing while reporting success. Rejecting it leaves
# PREFIX_FALLBACK empty, so only the bare candidates are tried -- which is the
# correct conservative outcome, and the shape the reporting device actually has.
validate_jbroot() {
    case "$1" in
        '')
            printf 'jbroot produced no output'
            return 1
            ;;
        *'
'*)
            printf 'jbroot produced more than one line'
            return 1
            ;;
        /*)
            ;;
        *)
            printf 'jbroot produced a relative path'
            return 1
            ;;
    esac
    if [ ! -d "$1" ]; then
        printf 'jbroot named a path that is not a directory'
        return 1
    fi
    return 0
}

JBROOT_PREFIX=''
JBROOT_STATUS='not applicable to this install scheme'
if [ -n "$NEEDS_JBROOT" ]; then
    _jbroot="$(jbroot 2>/dev/null)"
    while :; do
        case "$_jbroot" in
            */) _jbroot="${_jbroot%/}" ;;
            *) break ;;
        esac
        [ -n "$_jbroot" ] || break
    done
    if _reason="$(validate_jbroot "$_jbroot")"; then
        JBROOT_PREFIX="$_jbroot"
        JBROOT_STATUS="$JBROOT_PREFIX"
    else
        JBROOT_STATUS="could not be resolved; ${_reason}"
    fi
    PREFIX_PRIMARY=''
    PREFIX_FALLBACK="$JBROOT_PREFIX"
else
    PREFIX_PRIMARY="$SCHEME_PREFIX"
    PREFIX_FALLBACK=''
fi

describe_prefix() {
    if [ -z "$1" ]; then
        printf 'the redirected root (bare paths)'
    else
        printf '%s' "$1"
    fi
}

warn() {
    printf 'NetworkManagerReborn: warning — %s\n' "$1" >&2
}

note() {
    printf 'NetworkManagerReborn: %s\n' "$1" >&2
}

# The resolved root is worth one line in the dpkg log either way. Both things
# removal does -- finding killall and deleting policy records -- are looked for
# under it, so a failed resolution changes what happened and has to be visible
# next to the warnings it causes.
if [ -n "$NEEDS_JBROOT" ] && [ -z "$JBROOT_PREFIX" ]; then
    warn "the jailbreak root ${JBROOT_STATUS}, so only bare paths were tried. a carrier defaults reload and any policy record cleanup were limited to what resolves without it."
fi

@LAUNCHCTL_SUPPORT@
@CARRIER_RESET_SUPPORT@

# dpkg calls prerm for four different things, and only one of them always means
# the package is going away:
#
#   remove          the package is being retired
#   upgrade         a successor is about to be unpacked over it
#   failed-upgrade  an upgrade aborted; runs from the incoming package
#   deconfigure     this package stays unpacked, to be reconfigured
#
# Reloading carrier defaults on a plain upgrade would be a silent, repeating
# regression: the successor reads the same policy records and ships the same
# Settings UI, so a reset there would undo the user's configuration on every
# update while the records still claimed it was applied. That mismatch is worse
# than doing nothing, because the UI and the daemon would both report enabled
# against a modem that had been reset.
#
# `upgrade` is also how dpkg spells a downgrade, and that case is not benign.
# Versions below @CARRIER_RESET_FLOOR@ predate the reload entirely, so handing a
# narrowed modem to one leaves the user with no in-package way to undo it. Those
# are treated as a retirement: reset, and discard the records, which that version
# does not understand either.
#
# The comparison is delegated to dpkg rather than reimplemented. dpkg uses the
# same action for upgrade and downgrade, so this must be an ordering question and
# not a string test, and the process asking it is already running inside dpkg.
CARRIER_RESET_FLOOR='@CARRIER_RESET_FLOOR@'
ACTION="${1:-}"
INCOMING_VERSION="${2:-}"
RETIRING=''
RETIRE_REASON=''

# Resolved once, up front, because everything below that runs a child process
# needs it: the version comparison, the carrier reset, and the launchctl bootout
# all go through launchctl_run, and launchctl_run refuses to run unbounded.
#
# Hoisted here after getting it wrong. It used to be resolved inside the reset
# block, which is after the version comparison, so every comparison returned 125
# for want of a delay command -- read as "below the floor" -- and every ordinary
# upgrade reloaded carrier defaults. Exactly the silent repeating regression the
# comment above says must not happen, produced by the code meant to prevent it.
if ! resolve_delay_command; then
    warn "no usable delay command was found, so no child process could be bounded. nothing that needs one was run: the modem may still be narrowed, and a running maintenance owner was left alone."
fi

case "$ACTION" in
    remove)
        RETIRING=1
        RETIRE_REASON='the package is being removed'
        ;;
    upgrade)
        if [ -z "$INCOMING_VERSION" ]; then
            # No version to compare. Fail toward an un-narrowed modem: a reset
            # the user did not need is undone with one tap, while a downgrade
            # that skipped it leaves no in-package way back.
            RETIRING=1
            RETIRE_REASON='dpkg named no incoming version, so the successor could not be shown to support the carrier defaults reload'
        elif [ -z "$LAUNCHCTL_DELAY" ]; then
            # Same fail-open direction, different cause: the comparison is a
            # child process and an unbounded one is not an option in a maintainer
            # script. Reported separately from a missing dpkg so the dpkg log
            # says which of the two it was.
            RETIRING=1
            RETIRE_REASON="the incoming version could not be compared against ${CARRIER_RESET_FLOOR} under a deadline"
        elif ! resolve_dpkg_command; then
            RETIRING=1
            RETIRE_REASON="no usable dpkg was found${DPKG_REPORT:+ (${DPKG_REPORT})}, so the incoming version could not be compared against ${CARRIER_RESET_FLOOR}"
        elif version_is_at_least "$INCOMING_VERSION" "$CARRIER_RESET_FLOOR"; then
            note "version ${INCOMING_VERSION} supports the carrier defaults reload, so this upgrade left the band configuration and its records alone."
        else
            RETIRING=1
            RETIRE_REASON="version ${INCOMING_VERSION} predates the carrier defaults reload, or the comparison did not answer, so it could not be relied on to undo a narrowed modem"
        fi
        ;;
    *)
        note "action '${ACTION:-none}' keeps this package installed, so carrier defaults were left alone."
        ;;
esac

if [ -n "$RETIRING" ]; then
    note "reloading carrier defaults: ${RETIRE_REASON}."
fi

# Run the carrier defaults reload before removal. This is the only place a
# forced NR band configuration is undone outside the package itself, and it
# runs even when the daemon cannot be booted out: a reset that completes but
# cannot be verified is still better than leaving the modem narrowed.
#
# A failure here does not block removal. The user is warned, and the policy
# records stay on disk so a reinstall can retry the reset.
reset_succeeded=0
if [ -z "$RETIRING" ]; then
    :
elif [ -z "$LAUNCHCTL_DELAY" ]; then
    warn "the carrier defaults reload could not be bounded and was skipped. removal continues, and the modem may still be narrowed."
elif ! resolve_carrier_killall; then
    warn "no usable killall was found${CARRIER_KILLALL_REPORT:+ (${CARRIER_KILLALL_REPORT})}, so the carrier defaults reload could not be run. removal continues, and the modem may still be narrowed."
elif carrier_reset_defaults; then
    reset_succeeded=1
    note "carrier defaults reloaded."
else
    warn "the carrier defaults reload could not complete both invocations, so the modem may still be narrowed. removal continues, and the policy records were left in place so a reinstall can retry."
fi

# Records are discarded only after a confirmed reset. On an unconfirmed one they
# are the only remaining evidence that the modem was left narrowed, and a
# reinstall needs that to know there is something to undo.
if [ "$reset_succeeded" -eq 1 ] && ! discard_policy_records; then
    warn "carrier defaults were reloaded but some policy records could not be removed, so a reinstall may report a stale transition."
fi

# The band selection is user preference data, not policy evidence. It is not in
# the policy record set and deliberately outlives the off state, because a
# selection can be edited while the feature is disabled. Removal is the one
# moment it has no owner left, and dpkg will not do it: the file lives under
# /var/mobile/Library/Preferences and was never part of the package payload.
#
# Leaving it behind is worse than untidy. A stored band the current SIM no longer
# offers makes the toggle refuse, and nothing in Settings names the stored value,
# so the one remedy every user reaches for -- remove and reinstall -- would
# silently inherit the same selection and fail the same way.
#
# Only on `remove`, and deliberately not on the downgrade path: a downgrade keeps
# a package installed, and the version it lands on does not read this file at
# all, so the selection is still the user's to keep. Independent of whether the
# reset worked, because preference data cannot leave the modem in a worse state.
if [ "$ACTION" = remove ] && ! discard_band_selection; then
    warn "the stored NR band selection could not be discarded, so a later reinstall will inherit it."
fi

# Stop the daemon before dpkg unlinks its binary. Deliberately not a blocking
# condition: dpkg removes the plist along with the package, so a job that
# cannot be booted out now also cannot come back after a reboot.
if [ -z "$LAUNCHCTL_DELAY" ]; then
    :  # already warned once, up front
elif resolve_launchctl; then
    launchd_bootout
    bootout_status=$?
    if [ "$bootout_status" -eq 1 ]; then
        warn "the maintenance owner could not be stopped and may keep running until the next reboot. removal continues, and the launchd job is removed with the package, so it will not return."
    elif [ "$bootout_status" -eq 2 ]; then
        warn "launchd did not answer within ${LAUNCHCTL_DEADLINE_SECONDS}s, so the maintenance owner may keep running until the next reboot. removal continues, and the launchd job is removed with the package, so it will not return."
    fi
else
    warn "launchctl could not be run${LAUNCHCTL_REPORT:+ (tried ${LAUNCHCTL_REPORT})}, so a running maintenance owner was left alone. It stops at the next reboot, and the launchd job is removed with the package."
fi

exit 0