#!/bin/sh
# Generated from package-actions/postinst.sh.in by
# scripts/patch-maintenance-launchd.py. Do not edit the installed copy.
#
# Why this is shell and not a compiled tool
# -----------------------------------------
# On roothide both the jbroot path redirection and the sandbox exemption come
# from basebin/bootstrap.dylib, injected through DYLD_INSERT_LIBRARIES. The
# reporting device ran a compiled maintainer script as euid 0 that could stat,
# read and parse files inside the jailbreak root but got EPERM on every write and
# on every child exec, and saw bare paths such as /bin/launchctl as ENOENT. That
# is a process-level restriction, not permissions and not a read-only mount.
#
# roothide's own packages do this work in shell. Their bootstrapd postinst is:
#
#   plutil -xml /basebin/LaunchDaemons/com.roothide.bootstrap.bootstrapd.plist
#   sed -i "s|@JBROOT@|$(jbroot)|g" /basebin/LaunchDaemons/...
#
# Note the two different prefixes there: a bare /basebin path is being edited,
# while $(jbroot) supplies the absolute path written into the file. launchd is
# not subject to any redirection, so the plist must name a real absolute path;
# the script editing it may or may not be redirected.
#
# Which of those this script gets is not settled by reading the bootstrap
# source. exechook.c decides injection with isSubPathOf(path, jbroot("/")), and
# whether dpkg hands the maintainer script a bare or a jbroot-absolute path is
# not determinable from source alone. So nothing here assumes: each installed
# file is resolved against both candidate prefixes and the one that matched is
# named in the install log, which turns the open question into evidence.

SCHEME_PREFIX='@PREFIX@'
NEEDS_JBROOT='@NEEDS_JBROOT@'

PLIST_RELATIVE='/Library/LaunchDaemons/me.nixuge.networkmanager.maintenance.plist'
GUARD_RELATIVE='/usr/libexec/networkmanager-install-guard'

note() {
    printf 'NetworkManagerReborn: %s\n' "$1" >&2
}

warn() {
    printf 'NetworkManagerReborn: warning — %s\n' "$1" >&2
}

# ---------------------------------------------------------------------------
# Candidate prefixes. At most two, and which applies is a property of the
# running process, so both are tried rather than guessed.
#
# roothide: the bare path first. If this shell does have the redirection then a
#           bare path is the correct one, and the jbroot-absolute path resolves
#           to the same file anyway.
# rootless: exactly one real prefix. A bare path would point outside the
#           jailbreak, so it is never a candidate.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# jbroot's output is an external input and is validated before use. An
# implausible value must not be prepended to anything: a non-absolute or
# multi-line prefix that happens to be non-empty would be substituted into the
# plist as-is, the @JBROOT@ placeholder would be gone, every later check would
# pass, and launchd would hold a path that cannot exist. That is the one outcome
# worse than not substituting at all, because it reports success.
#
# Trailing slashes are normalised rather than rejected, so the plist does not
# gain a doubled separator; the value is never normalised down to empty, because
# empty means "unresolved" everywhere else in this script.
# ---------------------------------------------------------------------------
validate_jbroot() {
    case "$1" in
        '')
            printf 'jbroot produced no output'
            return 1
            ;;
        *'
'*)
            printf 'jbroot produced more than one line'
            return 1
            ;;
        /*)
            ;;
        *)
            printf 'jbroot produced a relative path'
            return 1
            ;;
    esac
    if [ ! -d "$1" ]; then
        printf 'jbroot named a path that is not a directory'
        return 1
    fi
    return 0
}

JBROOT_PREFIX=''
JBROOT_STATUS='not applicable to this install scheme'
if [ -n "$NEEDS_JBROOT" ]; then
    _jbroot="$(jbroot 2>/dev/null)"
    while :; do
        case "$_jbroot" in
            */) _jbroot="${_jbroot%/}" ;;
            *) break ;;
        esac
        [ -n "$_jbroot" ] || break
    done
    if _reason="$(validate_jbroot "$_jbroot")"; then
        JBROOT_PREFIX="$_jbroot"
        JBROOT_STATUS="$JBROOT_PREFIX"
    else
        JBROOT_STATUS="could not be resolved; ${_reason}"
    fi
    PREFIX_PRIMARY=''
    PREFIX_FALLBACK="$JBROOT_PREFIX"
    # What launchd itself must use. launchd is never redirected, so this is the
    # jbroot even where a bare path works for this script.
    LAUNCHD_PREFIX="$JBROOT_PREFIX"
else
    PREFIX_PRIMARY="$SCHEME_PREFIX"
    PREFIX_FALLBACK=''
    LAUNCHD_PREFIX="$SCHEME_PREFIX"
fi

describe_prefix() {
    if [ -z "$1" ]; then
        printf 'the redirected root (bare paths)'
    else
        printf '%s' "$1"
    fi
}

candidate_list() {
    describe_prefix "$PREFIX_PRIMARY"
    if [ -n "$PREFIX_FALLBACK" ]; then
        printf ' and %s' "$PREFIX_FALLBACK"
    fi
}

# resolve() assigns RESOLVED_PATH and RESOLVED_PREFIX. It must not be called in a
# command substitution: that runs in a subshell and the caller would keep an
# empty RESOLVED_PREFIX while still getting a usable path, so every diagnostic
# would name the wrong prefix.
RESOLVED_PATH=''
RESOLVED_PREFIX=''
resolve() {
    _relative="$1"
    RESOLVED_PATH=''
    RESOLVED_PREFIX=''
    if [ -e "${PREFIX_PRIMARY}${_relative}" ]; then
        RESOLVED_PREFIX="$PREFIX_PRIMARY"
    elif [ -n "$PREFIX_FALLBACK" ] && [ -e "${PREFIX_FALLBACK}${_relative}" ]; then
        RESOLVED_PREFIX="$PREFIX_FALLBACK"
    else
        return 1
    fi
    RESOLVED_PATH="${RESOLVED_PREFIX}${_relative}"
    return 0
}

# ---------------------------------------------------------------------------
# The launchd plist: give it the real absolute path launchd will need.
# ---------------------------------------------------------------------------
patch_jbroot() {
    if ! resolve "$PLIST_RELATIVE"; then
        warn "the launchd plist was not found under $(candidate_list), so the maintenance daemon cannot be registered. jbroot: ${JBROOT_STATUS}."
        return 1
    fi
    plist="$RESOLVED_PATH"
    note "resolved the launchd plist under $(describe_prefix "$RESOLVED_PREFIX")."

    # Whether a substitution is required is settled at package time, not by
    # inspecting the file. NEEDS_JBROOT is empty for exactly the lanes whose
    # prefix is baked into the plist already.
    #
    # Asking the file instead was a real bug, twice over. Theos converts every
    # staged plist to binary1 in its FINALPACKAGE internal-package step, which
    # runs after before-package, so both lanes ship a *binary* plist no matter
    # what the packaging script wrote. So:
    #
    #   - A format question placed first warns about the rootless plist, which is
    #     completely correct and needs no rewrite at all. On a bootstrap without
    #     plutil that warning is permanent and unfixable.
    #   - A `grep @JBROOT@` question placed first is not portable. GNU grep -a
    #     matches the placeholder inside a binary plist; the BSD grep on macOS
    #     reports no match for the same file and pattern. "No match" is the
    #     success branch, so on a bootstrap with a BSD-ish grep the roothide
    #     placeholder would survive with nothing at all in the install log. That
    #     is the exact failure mode this whole file is written to prevent, and CI
    #     caught it: the Ubuntu host-tests job passed while both macOS packaging
    #     jobs failed eight tests.
    #
    # The lane answers the question without reading anything, so neither quirk
    # can decide it.
    if [ -z "$NEEDS_JBROOT" ]; then
        return 0
    fi

    if [ -z "$JBROOT_PREFIX" ]; then
        warn "the jailbreak root ${JBROOT_STATUS}, so ${plist} still contains the @JBROOT@ placeholder and launchd cannot start the daemon."
        return 1
    fi

    # A textual rewrite is required, so the format now has to be settled. Apple's
    # plutil spells the conversion -convert xml1 and roothide's bootstrap spells
    # it -xml; try both. roothide ships plutil and its own bootstrapd postinst
    # relies on it, which is what makes requiring it acceptable on this lane and
    # unacceptable on the other.
    plutil -convert xml1 "$plist" >/dev/null 2>&1 ||
        plutil -xml "$plist" >/dev/null 2>&1 || true

    # The conversion is not allowed to be best-effort. Where grep *can* see into
    # a binary plist, sed would rewrite 8 bytes to a longer path inside a
    # length-prefixed string and leave the trailer's offset table stale, giving
    # launchd a file it cannot parse at all — while every later check passes,
    # because the placeholder really is gone. Leaving the plist unsubstituted is
    # recoverable by reinstalling; corrupting it and reporting success is not.
    #
    # Confirmed positively, so an unreadable file or a missing grep cannot pass
    # for XML. Sniffing the magic bytes would mean depending on head or dd as
    # well, and every tool this script needs is one more thing a given bootstrap
    # can be missing.
    grep -qa '<?xml' "$plist"
    xml_status=$?
    if [ "$xml_status" -eq 1 ]; then
        warn "${plist} is not XML, so plutil is unavailable or failed; refusing to run a textual substitution over it. The @JBROOT@ placeholder remains and launchd cannot start the daemon."
        return 1
    fi
    if [ "$xml_status" -ne 0 ]; then
        warn "could not read ${plist} to confirm it is XML (grep exit ${xml_status}); refusing to rewrite it. The @JBROOT@ placeholder remains and launchd cannot start the daemon."
        return 1
    fi

    # Only now is the placeholder question asked, and only against text, where
    # every grep agrees. grep's exit status is three-valued: 0 match, 1 no match,
    # 2 or more error. Used as a boolean, an unreadable plist or a missing grep
    # would be indistinguishable from "already substituted", which is the success
    # branch.
    grep -qa '@JBROOT@' "$plist"
    placeholder_status=$?
    if [ "$placeholder_status" -eq 1 ]; then
        # Already substituted by an earlier run. Idempotent by design: dpkg
        # reruns postinst on reconfigure and on a repeated install.
        return 0
    fi
    if [ "$placeholder_status" -ne 0 ]; then
        warn "could not read ${plist} to look for the @JBROOT@ placeholder (grep exit ${placeholder_status}); treat the maintenance daemon as unregistered."
        return 1
    fi

    # Rewrite through a sibling and copy the bytes back, so the file keeps the
    # mode and ownership dpkg gave it and sed -i portability is not a factor.
    #
    # The name is predictable, but the directory is root-owned on both lanes, so
    # this is not a privilege boundary: anyone who could plant a symlink here
    # could edit the plist directly. The unlink is for stale state from a crashed
    # earlier run, not for an attacker.
    scratch="${plist}.networkmanager.$$"
    rm -f "$scratch"
    if ! sed "s|@JBROOT@|${JBROOT_PREFIX}|g" "$plist" > "$scratch" 2>/dev/null; then
        rm -f "$scratch"
        warn "could not create a replacement next to ${plist} (euid $(id -u), jbroot ${JBROOT_PREFIX}); the plist still contains the @JBROOT@ placeholder."
        return 1
    fi
    if ! cat "$scratch" > "$plist" 2>/dev/null; then
        rm -f "$scratch"
        warn "could not write ${plist} (euid $(id -u)); it still contains the @JBROOT@ placeholder. This is the same write refusal a compiled maintainer script hit, now reached from shell."
        return 1
    fi
    rm -f "$scratch"

    # Same three-valued status as above, and the stakes are reversed here: an
    # error must not read as "no placeholder found", which is the success case.
    grep -qa '@JBROOT@' "$plist"
    survived_status=$?
    if [ "$survived_status" -eq 0 ]; then
        warn "the @JBROOT@ placeholder survived substitution in ${plist}; sed reported success but changed nothing."
        return 1
    fi
    if [ "$survived_status" -ne 1 ]; then
        warn "could not confirm the substitution in ${plist} (grep exit ${survived_status}); treat the maintenance daemon as unregistered."
        return 1
    fi
    note "wrote the jailbreak root into the launchd plist."
    return 0
}

patch_jbroot || true

# ---------------------------------------------------------------------------
# The policy guard owns the rest: clearing the removal guard when that is safe,
# validating the launchd contract, and loading the job if launchctl is
# reachable. It only reads and reports, so it works without the privileges this
# script needs.
# ---------------------------------------------------------------------------
if ! resolve "$GUARD_RELATIVE"; then
    warn "the install guard was not found under $(candidate_list), so band policy state was not validated. jbroot: ${JBROOT_STATUS}."
    exit 0
fi

# Hand both prefixes over instead of letting the guard re-derive them. The shell
# has already proven which one exists; the guard cannot repeat that reasoning
# correctly, because it is invoked through a bare path and so its own executable
# path carries no .jbroot- component.
#
# These are two different questions and conflating them was the original mistake.
# The install prefix is what the guard prepends to read a file, and empty is the
# normal roothide answer, so it is exported even when empty. The launchd prefix is
# what must appear inside the plist, and it can never be empty, so it is exported
# only when known; leaving it unset makes the guard say so instead of comparing
# against a bare path launchd would never use.
NETWORKMANAGER_INSTALL_PREFIX="$RESOLVED_PREFIX"
export NETWORKMANAGER_INSTALL_PREFIX
if [ -n "$LAUNCHD_PREFIX" ]; then
    NETWORKMANAGER_LAUNCHD_PREFIX="$LAUNCHD_PREFIX"
    export NETWORKMANAGER_LAUNCHD_PREFIX
fi

"$RESOLVED_PATH" "$@"
exit $?
